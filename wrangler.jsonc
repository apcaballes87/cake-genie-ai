{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genieph-container-staging",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "containers": [
    {
      "class_name": "GenieContainer",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GENIE_APP", "class_name": "GenieContainer" }]
  },
  "exports": {
    "GenieContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": { "crons": [] },
  "env": {
    "production": {
      "name": "genieph-container-production",
      "workers_dev": true,
      "containers": [
        {
          "class_name": "GenieContainer",
          "image": "./Dockerfile.cloudflare",
          "max_instances": 1,
          "instance_type": "basic"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "GENIE_APP", "class_name": "GenieContainer" }]
      },
      "exports": {
        "GenieContainer": { "type": "durable-object", "storage": "sqlite" }
      },
      "triggers": { "crons": [] }
    }
  }
}
