    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const webhookItem = $input.item.json;\nconst payload = webhookItem.body ?? webhookItem;\n\nif (payload.event !== 'customer_chat.message_created') {\n  throw new Error('Unsupported event');\n}\n\nconst data = payload.data ?? {};\nconst textValue = (value, fallback = '') =>\n  typeof value === 'string' && value.trim() ? value.trim() : fallback;\n\nconst imageUrl = textValue(data.imageUrl);\nconst rawMessage = textValue(\n  data.content,\n  imageUrl ? '(Customer sent an image)' : '(No message text)'\n);\nconst message = rawMessage.length > 2500\n  ? `${rawMessage.slice(0, 2500)}…`\n  : rawMessage;\n\nconst receivedAt = new Date(textValue(data.createdAt, payload.sentAt));\nconst receivedLabel = Number.isNaN(receivedAt.getTime())\n  ? textValue(data.createdAt, payload.sentAt ?? 'Unknown')\n  : receivedAt.toLocaleString('en-PH', {\n      timeZone: 'Asia/Manila',\n      dateStyle: 'medium',\n      timeStyle: 'short',\n    });\n\nconst lines = [\n  '🔔 New Genie.ph customer message',\n  '',\n  `From: ${textValue(data.customerName, 'Guest customer')}`,\n];\n\nconst customerEmail = textValue(data.customerEmail);\nif (customerEmail) lines.push(`Email: ${customerEmail}`);\n\nlines.push('', 'Message:', message);\n\nconst pageTitle = textValue(data.pageTitle);\nconst pageUrl = textValue(data.pageUrl);\nif (pageTitle || pageUrl) {\n  lines.push('', `Page: ${pageTitle || pageUrl}`);\n  if (pageTitle && pageUrl) lines.push(pageUrl);\n}\n\nlines.push('', `Conversation: ${textValue(data.conversationId, 'Unknown')}`);\nlines.push(`Received: ${receivedLabel} (Manila)`);\n\nreturn {\n  json: {\n    textContent: lines.join('\\n'),\n    imageUrl,\n    hasImage: Boolean(imageUrl),\n    conversationId: textValue(data.conversationId),\n    messageId: textValue(data.messageId),\n  },\n};"
      },
